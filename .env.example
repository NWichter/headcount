# Solana RPC: local validator or devnet
SOLANA_RPC_URL=http://127.0.0.1:8899
# localnet | devnet (explorer links, wallet behaviour)
SOLANA_CLUSTER=localnet
# Token for all events of this app: a classic SPL mint with 6 decimals (USDC on devnet: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU)
MINT=
# Public https URL for phone wallets (Solana Pay), e.g. from a tunnel
PUBLIC_URL=http://localhost:4040
PORT=4040
# Symbol shown for MINT (default USDC)
MINT_SYMBOL=USDC
# Optional: base58 secret key of an app wallet that pays fees and rent for
# commits, pledges, door check-ins and refunds ("No SOL needed" on phones)
SPONSOR_SECRET_KEY=
# Limits for sponsored transactions (per wallet per hour, whole app per day)
SPONSOR_PER_WALLET_PER_HOUR=6
SPONSOR_PER_DAY=300
# Test networks only: mint authority of MINT, enables the test-token faucet
TEST_MINT_AUTHORITY=
